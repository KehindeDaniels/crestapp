# Read by pnpm (Hostinger's Deploy Web App uses pnpm for this project).
#
# node-linker=hoisted → flat node_modules (npm-style) instead of pnpm's default
# symlinked layout. Two reasons: (1) it changes the install layout, forcing a
# fresh install that sidesteps Hostinger's cached (pre-fix) pnpm store where
# sharp/unrs-resolver were recorded as "do not build"; (2) hoisted linking is
# the most compatible layout for native deps like sharp. The build-script
# allow-list itself lives in pnpm-workspace.yaml (onlyBuiltDependencies).
node-linker=hoisted
