# @hookform/resolvers lists several validation libs (valibot, yup, …) as
# OPTIONAL peers; we only use zod. npm 7+ errors on those optional-peer
# mismatches (ERESOLVE) even though they don't apply to us. legacy-peer-deps
# restores npm 6 behavior (ignore peer conflicts) so install succeeds — locally
# and on Hostinger's default `npm install`.
legacy-peer-deps=true
